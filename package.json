{
  "name": "faios",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint --concurrency=1",
    "test": "turbo run test",
    "test:integration:execution": "pnpm --filter @faios/workers test:integration",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@faios/eslint-config": "workspace:*",
    "@faios/prettier-config": "workspace:*",
    "@faios/typescript-config": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
