{
  "name": "@faios/database",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "lint": "eslint .",
    "prisma:migrate:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url postgresql://faios:faios@localhost:5432/faios_shadow?schema=public --exit-code",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:generate": "prisma generate",
    "test": "echo \"No tests yet\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@faios/eslint-config": "workspace:*",
    "@faios/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
