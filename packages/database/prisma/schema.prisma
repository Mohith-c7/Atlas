generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationChannel {
  CHAT
  VOICE
}

enum MessageRole {
  FOUNDER
  ASSISTANT
  SYSTEM
  TOOL
}

enum CommandStatus {
  RECEIVED
  PLANNING
  AWAITING_APPROVAL
  EXECUTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ToolInvocationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum MemoryKind {
  FOUNDER_PROFILE
  COMPANY_FACT
  PREFERENCE
  DECISION
  CONTACT
  WORKFLOW_PATTERN
  SUMMARY
}

enum FounderSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

model FounderAccount {
  id             String                  @id @default(cuid())
  email          String                  @unique
  displayName    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  authIdentities FounderAuthIdentity[]
  sessions       FounderSession[]
  billingCustomer BillingCustomer?
  subscriptions   Subscription[]
  usageCounters   UsageCounter[]
  profile        FounderProfile?
  companyProfile CompanyProfile?
  integrations   IntegrationConnection[]
  oauthStates    IntegrationOAuthState[]
  conversations  Conversation[]
  commands       Command[]
  memoryItems    MemoryItem[]
}

model BillingCustomer {
  id                 String         @id @default(cuid())
  founderId          String         @unique
  founder            FounderAccount @relation(fields: [founderId], references: [id], onDelete: Cascade)
  provider           String
  providerCustomerId String         @unique
  email              String
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  subscriptions      Subscription[]
  webhookEvents      BillingWebhookEvent[]

  @@index([provider, providerCustomerId])
}

model Subscription {
  id                     String             @id @default(cuid())
  founderId              String
  founder                FounderAccount     @relation(fields: [founderId], references: [id], onDelete: Cascade)
  billingCustomerId      String?
  billingCustomer        BillingCustomer?   @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  provider               String
  providerSubscriptionId String?            @unique
  status                 SubscriptionStatus
  planKey                String
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  trialEndsAt            DateTime?
  metadata               Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([founderId, status])
  @@index([planKey, status])
  @@index([provider, providerSubscriptionId])
}

model PlanEntitlement {
  id         String   @id @default(cuid())
  planKey    String
  featureKey String
  enabled    Boolean  @default(true)
  limit      Int?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([planKey, featureKey])
  @@index([planKey])
}

model UsageCounter {
  id          String         @id @default(cuid())
  founderId   String
  founder     FounderAccount @relation(fields: [founderId], references: [id], onDelete: Cascade)
  featureKey  String
  periodStart DateTime
  periodEnd   DateTime
  used        Int            @default(0)
  limit       Int?
  source      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([founderId, featureKey, periodStart, periodEnd])
  @@index([founderId, featureKey])
  @@index([periodEnd])
}

model BillingWebhookEvent {
  id                String           @id @default(cuid())
  provider          String
  providerEventId   String
  billingCustomerId String?
  billingCustomer   BillingCustomer? @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  eventType         String
  status            String
  payload           Json?
  processedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([provider, providerEventId])
  @@index([eventType, status])
  @@index([billingCustomerId])
}

model FounderAuthIdentity {
  id              String         @id @default(cuid())
  founderId       String
  founder         FounderAccount @relation(fields: [founderId], references: [id], onDelete: Cascade)
  provider        String
  providerSubject String
  email           String
  emailVerified   Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([provider, providerSubject])
  @@index([founderId])
  @@index([email])
}

model FounderSession {
  id         String               @id @default(cuid())
  founderId  String
  founder    FounderAccount       @relation(fields: [founderId], references: [id], onDelete: Cascade)
  tokenHash  String               @unique
  status     FounderSessionStatus @default(ACTIVE)
  issuedAt   DateTime             @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  rotatedAt  DateTime?
  lastSeenAt DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([founderId, status])
  @@index([tokenHash, status, expiresAt])
  @@index([expiresAt])
}

model FounderProfile {
  id               String         @id @default(cuid())
  founderId        String         @unique
  founder          FounderAccount @relation(fields: [founderId], references: [id], onDelete: Cascade)
  timezone         String?
  locale           String?
  operatingStyle   String?
  defaultVoice     String?
  approvalSettings Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model CompanyProfile {
  id          String         @id @default(cuid())
  founderId   String         @unique
  founder     FounderAccount @relation(fields: [founderId], references: [id], onDelete: Cascade)
  name        String?
  industry    String?
  stage       String?
  description String?
  context     Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model IntegrationConnection {
  id             String          @id @default(cuid())
  founderId      String
  founder        FounderAccount  @relation(fields: [founderId], references: [id], onDelete: Cascade)
  provider       String
  accountLabel   String?
  status         String
  capabilityKeys String[]
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  credential     IntegrationCredential?
  invocations    ToolInvocation[]

  @@unique([founderId, provider])
  @@index([founderId, provider])
}

model IntegrationCredential {
  id              String                @id @default(cuid())
  integrationId   String                @unique
  integration     IntegrationConnection @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  encryptedPayload Json
  keyVersion      String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([keyVersion])
}

model IntegrationOAuthState {
  id          String         @id @default(cuid())
  founderId   String
  founder     FounderAccount @relation(fields: [founderId], references: [id], onDelete: Cascade)
  provider    String
  state       String         @unique
  redirectUri String
  metadata    Json?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([founderId, provider, expiresAt])
  @@index([state, expiresAt])
}

model Conversation {
  id        String              @id @default(cuid())
  founderId String
  founder   FounderAccount      @relation(fields: [founderId], references: [id], onDelete: Cascade)
  channel   ConversationChannel
  title     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  messages  Message[]
  commands  Command[]

  @@index([founderId, updatedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())
  command        Command?

  @@index([conversationId, createdAt])
}

model Command {
  id             String          @id @default(cuid())
  founderId      String
  founder        FounderAccount  @relation(fields: [founderId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String?         @unique
  message        Message?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  source         ConversationChannel
  rawInput       String
  status         CommandStatus
  summary        String?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  plan           ExecutionPlan?
  approvals      ApprovalRequest[]
  invocations    ToolInvocation[]

  @@index([founderId, createdAt])
  @@index([status, updatedAt])
}

model ExecutionPlan {
  id        String   @id @default(cuid())
  commandId String   @unique
  command   Command  @relation(fields: [commandId], references: [id], onDelete: Cascade)
  summary   String
  steps     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  commandId   String
  command     Command        @relation(fields: [commandId], references: [id], onDelete: Cascade)
  reason      String
  payload     Json?
  status      ApprovalStatus
  requestedAt DateTime       @default(now())
  resolvedAt  DateTime?

  @@index([commandId, status])
}

model ToolInvocation {
  id              String                 @id @default(cuid())
  commandId       String
  command         Command                @relation(fields: [commandId], references: [id], onDelete: Cascade)
  integrationId   String?
  integration     IntegrationConnection? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  capabilityKey   String
  provider        String?
  status          ToolInvocationStatus
  requestPayload  Json?
  responsePayload Json?
  errorCode       String?
  errorMessage    String?
  retryCount      Int                    @default(0)
  maxRetries      Int                    @default(3)
  nextAttemptAt   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime               @default(now())

  @@index([commandId, createdAt])
  @@index([capabilityKey, status])
  @@index([status, nextAttemptAt])
}

model MemoryItem {
  id          String         @id @default(cuid())
  founderId   String
  founder     FounderAccount @relation(fields: [founderId], references: [id], onDelete: Cascade)
  kind        MemoryKind
  content     String
  source      String?
  confidence  Float?
  vectorRef   String?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([founderId, kind])
  @@index([vectorRef])
}
