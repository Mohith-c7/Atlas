{
  "name": "@faios/workers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "start": "node --import tsx src/main.ts",
    "test": "echo \"No tests yet\"",
    "test:integration": "tsx src/integration/execution-runtime.integration.ts && tsx src/integration/github-provider.integration.ts && tsx src/integration/memory-vector-runtime.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faios/contracts": "workspace:*",
    "@faios/database": "workspace:*",
    "@faios/env": "workspace:*",
    "@faios/events": "workspace:*",
    "@faios/logger": "workspace:*",
    "@faios/memory-vector": "workspace:*",
    "@faios/mcp": "workspace:*",
    "@faios/security": "workspace:*",
    "amqplib": "^2.0.1"
  },
  "devDependencies": {
    "@faios/eslint-config": "workspace:*",
    "@faios/typescript-config": "workspace:*",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
