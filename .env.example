NODE_ENV=development
APP_ENV=local
APP_NAME=Founder AI Operating System
APP_BASE_URL=http://localhost:3000
FAIOS_DEV_AUTH_ENABLED=true
NEXT_PUBLIC_FAIOS_SESSION_TOKEN=

DATABASE_URL=postgresql://faios:faios@localhost:5432/faios?schema=public
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://faios:faios@localhost:5672
EXECUTION_DISPATCH_ENABLED=false
WORKER_RABBITMQ_CONSUMER_ENABLED=false
WORKER_EXECUTION_LOOP_ENABLED=false
WORKER_EXECUTION_POLL_INTERVAL_MS=5000
WORKER_EXECUTION_CONCURRENCY=1
WORKER_REAL_PROVIDER_ADAPTERS_ENABLED=false
WORKER_MEMORY_VECTOR_RABBITMQ_CONSUMER_ENABLED=false
WORKER_MEMORY_VECTOR_LOOP_ENABLED=false
WORKER_MEMORY_VECTOR_POLL_INTERVAL_MS=5000
WORKER_METRICS_PORT=9101
QDRANT_URL=http://localhost:6333
QDRANT_MEMORY_COLLECTION=faios_memory
MEMORY_EMBEDDING_PROVIDER=auto
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_VECTOR_SYNC_MODE=async
MEMORY_VECTOR_JOB_DISPATCH_ENABLED=false
MEMORY_VECTOR_QUEUE_NAME=faios.memory.vector-sync
MEMORY_VECTOR_DEAD_LETTER_QUEUE_NAME=faios.memory.vector-sync.dlq
MEMORY_VECTOR_WORKER_CONCURRENCY=4
MEMORY_VECTOR_JOB_MAX_ATTEMPTS=5
MEMORY_VECTOR_RETRY_BASE_DELAY_MS=1000
MEMORY_VECTOR_RETRY_MAX_DELAY_MS=60000
S3_BUCKET=faios-local
S3_REGION=us-east-1
FAIOS_ENCRYPTION_KEY=
FAIOS_ENCRYPTION_KEY_VERSION=local-v1
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/integrations/github/oauth/callback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_PRICE_PRO=
LOG_LEVEL=info
FAIOS_TRACING_ENABLED=false
FAIOS_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
CORS_ALLOWED_ORIGINS=http://localhost:3000
BUSINESS_API_RATE_LIMIT_ENABLED=true
BUSINESS_API_RATE_LIMIT_WINDOW_MS=60000
BUSINESS_API_RATE_LIMIT_MAX_REQUESTS=300
BUSINESS_API_COMMAND_RATE_LIMIT_WINDOW_MS=60000
BUSINESS_API_COMMAND_RATE_LIMIT_MAX_REQUESTS=20
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

AI_ORCHESTRATOR_URL=http://localhost:8000
BUSINESS_API_URL=http://localhost:4000
NEXT_PUBLIC_BUSINESS_API_URL=http://localhost:4000
NEXT_PUBLIC_GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/integrations/github/oauth/callback
PUBLIC_WEB_URL=http://localhost:3000
